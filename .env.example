# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of authorized administrator email addresses.
# Accounts with an email in this list receive the 'admin' role after email verification.
ADMIN_EMAILS="admin@example.com"
OWNER_ADMIN_INITIAL_PASSWORD=""

# DARNA_DB_PATH: Path to the persistent SQLite database file.
DARNA_DB_PATH="./data/darna.sqlite"

# SMTP Configuration (Required in production for sending password reset and verification emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_FROM="no-reply@darna.ma"

# Cloud SQL PostgreSQL (Automatically injected at runtime by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Payment Gateway Configuration (CMI / Payzone Maroc - stays in Test Mode until configured)
PAYMENT_GATEWAY_MODE="test"
CMI_MERCHANT_ID=""
CMI_STORE_KEY=""

# OAuth Social Login (Google / Gmail & Apple Sign-In for iOS/Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""


